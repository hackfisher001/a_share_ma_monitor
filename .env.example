# 飞书群自定义机器人 Webhook（主通道，免费）
# 获取：飞书群 → 设置 → 群机器人 → 添加「自定义机器人」→ 复制 Webhook 地址
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 飞书企业自建应用（用于把行情表渲染成图片上传；手机可读性最好）
# 开放平台创建应用 → 开通「机器人」→ 权限「获取与上传图片或文件资源」im:resource
# → 发布版本 → 把该机器人拉进同一群
# FEISHU_APP_ID=cli_xxxxxxxx
# FEISHU_APP_SECRET=xxxxxxxx
# 可选：指定中文字体路径（Linux 建议安装 fonts-wqy-microhei）
# TABLE_IMAGE_FONT=/usr/share/fonts/truetype/wqy/wqy-microhei.ttc

# DeepSeek（日报/周报/月报点评）
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# 可选备用（未配飞书时才会用）
# WECOM_WEBHOOK_URL=
# DINGTALK_WEBHOOK_URL=

# 状态文件路径（同日去重）；服务器部署时可改为绝对路径
STATE_FILE=data/alert_state.json
